{
  "manifest_version": 3,
  "name": "Veracross Grade Estimator",
  "version": "1.1.0",
  "description": "Estimates your grade from the scored assignments on a Veracross class page. Runs entirely in your browser.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.veracross.com/*",
    "*://*.myveracross.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.veracross.com/*",
        "*://*.myveracross.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Veracross Grade Estimator",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  }
}
